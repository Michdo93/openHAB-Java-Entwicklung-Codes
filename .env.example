# Kopieren nach .env und Token eintragen. starte.sh lädt die Datei:
#   ./starte.sh kapitel10_erste_schritte/B01_Verbinden.java
# .env steht in .gitignore – Tokens gehören nicht ins Repository!
OPENHAB_URL=http://127.0.0.1:8080
OPENHAB_TOKEN=oh.buch.xxxxxxxxxxxxxxxx
# Alternativ Basic Authentication (in openHAB erst freischalten), nur Kapitel 10:
# OPENHAB_USER=admin
# OPENHAB_PASSWORD=geheim
